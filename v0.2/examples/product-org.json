  "roles": [
    {
      "id": "rol-research-manager",
      "name": "Research Manager",
      "description": "Sets the research strategy and decides which early ideas are worth taking into product design.",
      "department": "dep-research"
    },
    {
      "id": "rol-scientist",
      "name": "Scientist",
      "description": "Runs experiments and turns results into evidence the design team can build on.",
      "department": "dep-research"
    },
    {
      "id": "rol-project-lead",
      "name": "Project lead",
      "description": "Keeps research projects on schedule and makes sure findings reach the right people.",
      "department": "dep-research"
    },
    {
      "id": "rol-engineering-manager",
      "name": "Engineering Manager",
      "description": "Owns engineering capacity and signs off on what the team commits to deliver.",
      "department": "dep-design"
    },
    {
      "id": "rol-system-engineer",
      "name": "System Engineer",
      "description": "Holds the system view: requirements, interfaces and the trade-offs between them.",
      "department": "dep-design"
    },
    {
      "id": "rol-design-engineer",
      "name": "Design Engineer",
      "description": "Turns agreed requirements into detailed designs and prototypes.",
      "department": "dep-design"
    },
    {
      "id": "rol-marketing-manager",
      "name": "Marketing manager",
      "description": "Decides how and when new products are announced to customers.",
      "department": "dep-marketing"
    },
    {
      "id": "rol-market-analyst",
      "name": "Market analyst",
      "description": "Brings market data and customer insight into product decisions.",
      "department": "dep-marketing"
    }
  ],
