        "rol-marketing-manager"
      ],
      "reviewers": [
        "rol-market-analyst",
        "rol-system-engineer"
      ]
    },
    {
      "id": "doc-product-roadmap",
      "name": "Product roadmap",
      "description": "Priorities and target dates for the coming year.",
      "owners": [
        "rol-market-analyst"
      ],
      "reviewers": [
        "rol-research-manager"
      ]
    },
    {
      "id": "doc-design-roadmap",
      "name": "Design roadmap",
      "description": "The design function's plan, capacity and delivery risks.",
      "owners": [
        "rol-engineering-manager"
      ],
      "reviewers": [
        "rol-system-engineer"
      ]
    }
